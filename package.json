{
  "name": "agentic-sdlc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --port 3030",
    "build": "slidev build slides.md",
    "build:pages": "slidev build slides.md --base /agentic-sdlc/ --out dist",
    "skills:install": "node -e \"require('fs').cpSync('node_modules/@slidev/cli/skills/slidev','.github/skills/slidev',{recursive:true,force:true});console.log('Slidev skill copied to .github/skills/slidev')\""
  },
  "dependencies": {
    "@iconify-json/fluent": "1.2.61",
    "@iconify-json/icon-park-outline": "1.2.4",
    "@iconify-json/logos": "1.2.20",
    "@iconify-json/octicon": "1.2.40",
    "@iconify-json/selfhst": "1.2.29",
    "@slidev/cli": "53.1.0",
    "@slidev/theme-default": "0.25.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "playwright-chromium": "^1.65.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
